# MerchX Corporate Website — Environment Variables
# Copy this file to .env and fill in your values.

# Resend API key for the contact form (Phase 5)
# Get one from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# The email address that partnership enquiries will be sent TO
CONTACT_TO_EMAIL=contact@TODO_YOUR_DOMAIN.com

# (Vite frontend — optional, only needed if you self-host the backend separately)
# VITE_API_URL=https://your-domain.com
